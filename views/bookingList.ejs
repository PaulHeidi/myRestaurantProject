<a href="/adminLogout"><h4>Logout</h4></a>
<h2>Reservation List</h2>
              <div class="form-overlay3">
                    <!-- Filter Buttons --></br>
                    <button onclick="loadToday()">Today</button></br>
                    <button onclick="loadThisWeek()">This Week</button></br>
                    <button onclick="loadAll()">Show All</button>

                    <br><br>

                    <!-- Search by date -->
                    <input type="date" id="searchDate"></br>
                    <button onclick="searchByDate()">Search</button>

                    <br><br>
              </div>

    <div class="form-overlay2">
    <div class="container"><br><br>
      

<table border="1" id="userTable4">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Date</th>
            <th>Time</th>
            <th>Event</th>
            <th>Peoples</th>
            <th>Comments</th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

<script>
    // Load ALL bookings
    function loadAll() {
        fetch('http://localhost:3000/data4')
            .then(res => res.json())
            .then(data => renderTable(data));
    }

    // Load TODAY bookings
    function loadToday() {
        fetch('http://localhost:3000/data4?range=today')
            .then(res => res.json())
            .then(data => renderTable(data));
    }

    // Load THIS WEEK bookings
    function loadThisWeek() {
        fetch('http://localhost:3000/data4?range=week')
            .then(res => res.json())
            .then(data => renderTable(data));
    }

    // Search by DATE
    function searchByDate() {
        const date = document.getElementById("searchDate").value;

        if (!date) {
            alert("Please select a date");
            return;
        }

        fetch(`http://localhost:3000/data4?date=${date}`)
            .then(res => res.json())
            .then(data => renderTable(data));
    }

    // Render table rows
    function renderTable(data4) {
        const tableBody = document.querySelector('#userTable4 tbody');
        tableBody.innerHTML = '';

        data4.forEach(user => {
            const row = `
                <tr>
                    <td>${user.fName} ${user.lName}</td>
                    <td>${user.email}</td>
                    <td>${user.phone}</td>
                    <td>${user.date}</td>
                    <td>${user.time}</td>
                    <td>${user.event}</td>
                    <td>${user.number}</td>
                    <td>${user.comment}</td>
                </tr>
            `;
            tableBody.innerHTML += row;
        });
    }

    // Load all bookings on page load
    loadAll();
</script>



       


                                    


 


              



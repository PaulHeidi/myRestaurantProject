                        /* Container for image and form */
                             .image-container {
                                 position:relative; /* Needed for absolute positioning inside */
                                 display:flex;
                             }

                                          /* The background image */
                             .image-container img {
                             display: block;   
                            }

                        /* The form overlay */
                             .form-overlay {
                              position: absolute;
                              height: 100%;
                              width:20%;
                              top: 10px; /* Distance from top of image */
                              left: 800px; /* Distance from left of image */
                              background:transparent; /* Semi-transparent background */
                              padding: 0px;
                              border-radius: 1px;
                              box-shadow: 0 4px 8px rgba(0,0,0,0.2);
                        }

                         /* Form styling */
                            .form-overlay input{
                              background-color: rgba(250, 235, 215, 0.518);
                              height: 20px;    
                              padding: 0px;
                              width: 220px;
                              border-style:solid;

                        }
                             .form-overlay button {
                                height: 20%;
                                width: 30%;
                                position:relative;
                                border: none;
                                float:right;
                                background-color: rgba(250, 235, 215, 0.518);
                        }
                </style>



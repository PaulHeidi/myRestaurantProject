        <!--Online order list -->

           <h2>Online Orders</h2>

<table id="ordersTable" border="1" cellpadding="8" width="100%">
  <thead>
    <tr>
      <th>Customer details & dish name</th>
      <th>Price</th>
      <th>Order date</th>
      <th>Order time</th>
      <th>Pickup date</th>
      <th>Pickup time</th>
    </tr>
  </thead>
  <tbody></tbody>
</table>

<script>

  //date format 
  function formatDate(dateString) {
  const d = new Date(dateString);
  const day = String(d.getDate()).padStart(2, "0");
  const month = String(d.getMonth() + 1).padStart(2, "0");
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
}

  function loadOrders() {
    fetch("/get-orders")
      .then(res => res.json())
      .then(data => {
        const tbody = document.querySelector("#ordersTable tbody");
        tbody.innerHTML = "";

        const grouped = {};

        // Group by customer phone
        data.forEach(order => {
          if (!grouped[order.customer_phone]) {
            grouped[order.customer_phone] = {
              name: order.customer_name,
              phone: order.customer_phone,
              items: []
            };
          }

          grouped[order.customer_phone].items.push({
            dish: order.dishName,
            price: order.price,
            orderdate: order.order_date,
            ordertime: order.order_time,
            pickupdate: order.date,
            pickuptime: order.time
          });
        });

        // Render grouped rows
        Object.values(grouped).forEach(customer => {
          // Customer header row
          const headerRow = tbody.insertRow();
          headerRow.innerHTML = `
            <td colspan="6" style="
              font-weight:bold;
              background:#f0f0f0;
              padding:10px;
              font-size:18px;
            ">
              ${customer.name} (${customer.phone})
            </td>
          `;

          // Each product row
          customer.items.forEach(item => {
            const row = tbody.insertRow();

            row.insertCell(0).textContent = item.dish;
            row.insertCell(1).textContent = item.price.toFixed(2);
            row.insertCell(2).textContent = formatDate(item.orderdate);
            row.insertCell(3).textContent = item.ordertime;
            row.insertCell(4).textContent = formatDate(item.pickupdate);
            row.insertCell(5).textContent = item.pickuptime;
          });
        });
      })
      .catch(err => console.error("Error loading orders:", err));
  }

  loadOrders();
</script>





               

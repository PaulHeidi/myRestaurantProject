    <title>Users Table</title>
    <style>
        table { border-collapse: collapse; width: 80%; margin: 20px auto; }
        th, td { border: 2px solid #e9890a; background-color:#e9880a70; padding: 8px; text-align: left; font-size: larger; font-weight: bold;}

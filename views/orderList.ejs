<table id="ordersTable" border="1" cellpadding="8" width="100%">
  <thead>
    <tr>
      <th>Customer details & dish name</th>
      <th>Price</th>
      <th>Order date</th>
      <th>Order time</th>
      <th>Pickup date</th>
      <th>Pickup time</th>
      <th>comment</th>
    </tr>
  </thead>
  <tbody></tbody>
</table>

<script>
//Display date format
function formatDate(dateString) {
  const d = new Date(dateString);
  const day = String(d.getDate()).padStart(2, "0");
  const month = String(d.getMonth() + 1).padStart(2, "0");
  const year = d.getFullYear();
  return `${day}/${month}/${year}`;
}
//load all the online order order
function loadAll() {
  fetch("/get-orders")
    .then(res => res.json())
    .then(data => renderOrders(data));
}
//load today online order order
function loadToday() {
  fetch("/get-orders?range=today")
    .then(res => res.json())
    .then(data => renderOrders(data));
}
//load weekly online order
function loadThisWeek() {
  fetch("/get-orders?range=week")
    .then(res => res.json())
    .then(data => renderOrders(data));
}
// search online order a particular date wise
function searchOrderByDate() {
  const date = document.getElementById("orderSearchDate").value;
  if (!date) {
    alert("Please select a date");
    return;
  }

  fetch(`/get-orders?date=${date}`)
    .then(res => res.json())
    .then(data => renderOrders(data));
}

function renderOrders(data) {
  const tbody = document.querySelector("#ordersTable tbody");
  tbody.innerHTML = "";

  const grouped = {};

  data.forEach(order => {
    if (!grouped[order.customer_phone]) {
      grouped[order.customer_phone] = {
        name: order.customer_name,
        phone: order.customer_phone,
        items: []
      };
    }

    grouped[order.customer_phone].items.push({
      dish: order.dishName,
      price: order.price,
      orderdate: order.order_date,
      ordertime: order.order_time,
      pickupdate: order.pickup_date,
      pickuptime: order.pickup_time,
      comment: order.comment
    });
  });

  Object.values(grouped).forEach(customer => {
    const headerRow = tbody.insertRow();
    headerRow.innerHTML = `
      <td colspan="6" style="
        font-weight:bold;
        background:#f0f0f0;
        padding:10px;
        font-size:18px;
      ">
        ${customer.name} (${customer.phone})
      </td>
    `;

    customer.items.forEach((item, index) => {
  const row = tbody.insertRow();

  row.insertCell(0).textContent = item.dish;
  row.insertCell(1).textContent = item.price.toFixed(2);
  row.insertCell(2).textContent = formatDate(item.orderdate);
  row.insertCell(3).textContent = item.ordertime;
  row.insertCell(4).textContent = formatDate(item.pickupdate);
  row.insertCell(5).textContent = item.pickuptime;

  // Comment column (only on first row)
  const commentCell = row.insertCell(6);
  commentCell.textContent = index === 0 ? (item.comment || "") : "";
});


  });
}

loadAll();


</script>



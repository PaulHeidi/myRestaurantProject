<!DOCTYPE html>
<html>
<head>
    <title>Upload Invoice</title>
    <style>
        body { font-family: Arial; padding: 40px; }
    </style>
</head>
<body>

    <nav style="
        width: 100%;
        background: #1f2937;
        padding: 12px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    ">
        <div style="color: #fff; font-size: 20px; font-weight: bold;">Admin Dashboard</div>

        <div>

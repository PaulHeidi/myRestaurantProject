            <a href="/supplier-orders" style="color: #fff; margin-right: 20px; text-decoration: none;">Supplier Orders</a>
            <a href="/upload_invoice" style="color: #fff; margin-right: 20px; text-decoration: none;">Upload Invoice</a>
            <a href="/adminLogout" style="color: #f87171; font-weight: bold; text-decoration: none;">Logout</a>
        </div>
    </nav>

    <h1>Upload Invoice</h1>

    <!-- Option B: MUST POST to /upload-invoice -->
    <form action="/upload-invoice" method="POST" enctype="multipart/form-data">
        <input type="file" name="invoice" required>
        <button type="submit">Upload</button>
    </form>

</body>

// Render order list table
                        
                                            function submitOrderList() {
                                            const table = document.getElementById("destinationTable").tBodies[0];
                                            const data = [];

                                            const customerName = document.getElementById("customerName").value.trim();
                                            const customerPhone = document.getElementById("customerPhone").value.trim();
                                            const pickupDate = document.getElementById("date").value;
                                            const pickupTime = document.getElementById("time").value;

                                            // Validate customer info
                                            if (!customerName || !customerPhone) {
                                                alert("Please enter customer name and phone number.");
                                                return;
                                            }

                                            // Validate pickup date/time
                                            if (!pickupDate || !pickupTime) {
                                                alert("Please select pickup date and time.");
                                                return;
                                            }

                                            // Collect order items from table
                                            for (let row of table.rows) {
                                                const dishName = row.cells[0].textContent.trim();
                                                const price = parseFloat(row.cells[1].textContent.trim());

                                                if (dishName && !isNaN(price)) {
                                                data.push({
                                                    item_name: dishName,
                                                    item_price: price
                                                });
                                                }
                                            }

                                            if (data.length === 0) {
                                                alert("Order list is empty!");
                                                return;
                                            }

                                            // Send to backend
                                            fetch("/save-order", {
                                                method: "POST",
                                                headers: { "Content-Type": "application/json" },
                                                body: JSON.stringify({
                                                customer_name: customerName,
                                                customer_phone: customerPhone,
                                                date: pickupDate,     // pickup date
                                                time: pickupTime,     // pickup time
                                                rows: data            // order items
                                                })
                                            })
                                                .then(res => res.json())
                                                .then(response => {
                                                alert(response.message);
                                                })
                                                .catch(err => {
                                                console.error("Error:", err);
                                                alert("Failed to save order.");
                                                });
                                            }




                                                function loadOrders() {
                                                            fetch("/get-orders")
                                                            .then(res => res.json())
                                                            .then(data => {
                                                            const tbody = 
                                                            document.getElementById("destinationTable").tBodies[0];
                                                            tbody.innerHTML = "";
                                                            data.forEach(order => {
                                                            const row = tbody.insertRow();
                                                            row.insertCell(0).textContent = order.id;
                                                            row.insertCell(1).textContent = order.customer_name;
                                                            row.insertCell(2).textContent = order.customer_phone;
                                                            row.insertCell(3).textContent = order.dishName;
                                                            row.insertCell(4).textContent = order.price.toFixed(2);
                                                            row.insertCell(6).textContent = new
                                                            Date(order.order_time).toLocaleString();
                                                            });
                                                            })
                                                       
                                                            .catch(err => console.error("Error loading orders:", err));
                                                            }


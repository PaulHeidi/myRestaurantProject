            <h2>Feedback List</h2>
              <div class="form-overlay3">
                                <!-- Filter Buttons --></br>
                          <button onclick="loadToday()">Today</button>
                          <button onclick="loadThisWeek()">This Week</button>
                          <button onclick="loadAll()">Show All</button>

                          <br><br>

                          <input type="date" id="commSearchDate">
                          <button onclick="searchByDate()">Search</button>

                    <br><br>
              </div>

    <div class="form-overlay2">
    <div class="container"><br><br>
      
                      <table border="1" id="userTable6">
                          <thead>
                              <tr>
                                  <th>Name</th>
                                  <th>Email</th>
                                  <th>Phone</th>
                                  <th>Date</th>
                                  <th>Time</th>
                                  <th>Subject</th>
                                  <th>Message</th>
                              </tr>
                          </thead>
                          <tbody></tbody>
                      </table>

            <script>

                      function loadAll() {
                          fetch("http://localhost:3000/data6")
                              .then(res => res.json())
                              .then(data => renderCommunication(data));
                      }

                      function loadToday() {
                          fetch("http://localhost:3000/data6?range=today")
                              .then(res => res.json())
                              .then(data => renderCommunication(data));
                      }

                      function loadThisWeek() {
                          fetch("http://localhost:3000/data6?range=week")
                              .then(res => res.json())
                              .then(data => renderCommunication(data));
                      }

                      function searchByDate() {
                          const date = document.getElementById("commSearchDate").value;
                          if (!date) {
                              alert("Please select a date");
                              return;
                          }

                          fetch(`http://localhost:3000/data6?date=${date}`)
                              .then(res => res.json())
                              .then(data => renderCommunication(data));
                      }

                      function renderCommunication(data6) {
                          const tableBody = document.querySelector("#userTable6 tbody");
                          tableBody.innerHTML = "";

                          data6.forEach(user => {
                              const row = `
                                  <tr>
                                      <td>${user.name}</td>
                                      <td>${user.email}</td>
                                      <td>${user.phone}</td>
                                      <td>${user.date}</td>
                                      <td>${user.time}</td>
                                      <td>${user.subject}</td>
                                      <td>${user.message}</td>
                                  </tr>
                              `;
                              tableBody.innerHTML += row;
                          });
                      }

                      loadAll();

        </script>




              

    


 


              



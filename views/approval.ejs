<html>
    <head>
       <%- include('partials/header1.ejs') %>
       <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
       <header class="top-header">
                                <div class="header-left">
                                    <img src="/public/images/logo3.png" alt="Logo" class="header-logo">
                                </div>

                                <div class="header-center">
                                    <h1 class="header-title">KitchoraX</h1>
                                    <p class="kitchorax-subtitle">A modern, intelligent, next‑generation kitchen management system.</p>
                                </div>



                                <div class="header-right">
                                    <!-- Add logout button or other items here -->
                                </div>
                            </header>
                        <div class="bodyImg2" >

                        </div>   


                        




                 <style>
                        /*Sign up form */
                        /* Container for image and form */
                             .image-container {
                                 position: relative; /* Needed for absolute positioning inside */
                                 display:flex;
                             }

                         /* The background image */
                             .image-container img {
                             display: block;   
                            }

                       
                </style>


<!--contact us form-->
                <style>
                       

                        /* The form overlay */
                             .form-overlay1 {
                              background-size: cover;
                                background-position: center;
                                background-repeat: no-repeat;
                                width: 100%;                              
                                height: auto;
                                display:grid;           
                                border-radius: 5px;
                                border: 2px solid rgb(84, 143, 158);
                                background-image: url('/public/images/bgimage.png');
                                border-radius: 8px;
                                box-shadow: 6 8px 10x rgba(0,0,0,0.2);
                        }

                         /* Form styling */
                          
                             .form-overlay1 button {
                                height: 3%;
                                width: 20%;
                                position:relative;
                                border:2px solid;
                                background-color: green;
                        }
                         
                        
                </style>
                                <title>Users Table</title>
                                    <style>
                                        table { border-collapse: collapse; width: 50%; margin: 20px auto;}
                                        th, td { border: 2px solid #e9890a; background-color:#91c3c670; padding: 8px; text-align: left; font-size: large;font-weight: bold;}
                                        th { background-color: #488f94; }
                                        h2 { text-align: center; }
                                    
                                    </style>

               
                                
    </head>
        
    <body>
                    <% if (popup) { %>
                            <script>
                                Swal.fire({
                                    title: "Success!",
                                    text: "<%= popup %>",
                                    icon: "success",
                                    confirmButtonColor: "#3085d6"
                                });
                            </script>
                <% } %>


        <!--    <%- include('partials/navbar1.ejs') %> -->
          
<!--Form testing-->
<div class="form-overlay1">
                        
  
                <h2>Pending Admin Approvals</h2>

                                    <table border="1" cellpadding="8" cellspacing="0">
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Username</th>
                                            <th>Action</th>
                                        </tr>

                                        <% if (admins.length === 0) { %>
                                            <tr>
                                                <td colspan="4">No pending admins.</td>
                                            </tr>
                                        <% } %>

                                        <% admins.forEach(a => { %>
                                            <tr>
                                                <td><%= a.adminName %></td>
                                                <td><%= a.email %></td>
                                                <td><%= a.userName %></td>

                                                <td>

                                                    <!-- APPROVE -->
                                                    <form action="/admin/approve/<%= a.id %>" method="POST" style="display:inline;">
                                                        <button type="submit" style="
                                                            padding: 10px 20px;
                                                            background:#046e12;
                                                            color:white;
                                                            border:none;
                                                            border-radius:6px;
                                                            cursor:pointer;
                                                            margin-right:5px;
                                                        ">
                                                            Approve
                                                        </button>
                                                    </form>

                                                    <!-- REJECT -->
                                                    <form action="/admin/reject/<%= a.id %>" method="POST" style="display:inline;">
                                                        <button type="submit" style="
                                                            padding: 10px 20px;
                                                            background:#e63946;
                                                            color:rgb(253, 252, 252);
                                                            border:none;
                                                            border-radius:6px;
                                                            cursor:pointer;
                                                            margin-right:5px;
                                                        ">
                                                            Reject
                                                        </button>
                                                    </form>

                                                    <!-- DELETE -->
                                                    <form action="/admin/delete/<%= a.id %>" method="POST" style="display:inline;"
                                                        onsubmit="return confirm('Are you sure you want to DELETE this admin permanently?');">
                                                        <button type="submit" style="
                                                            padding: 10px 20px;
                                                            background:#e63946;
                                                            color:white;
                                                            border:none;
                                                            border-radius:6px;
                                                            cursor:pointer;
                                                        ">
                                                            Delete
                                                        </button>
                                                    </form>

                                                </td>
                                            </tr>
                                        <% }) %>
                                    </table>

                        <p><a href="/adminPage">Back to Admin Page</a></p>

                                                <div style="margin-top:20px; text-align:center;">
                                                    <a href="/memberLogin" style="
                                                        display:inline-block;
                                                        padding:10px 20px;
                                                        background:#e63946;
                                                        color:rgb(28, 10, 162);
                                                        border-radius:6px;
                                                        text-decoration:none;
                                                        font-weight:bold;
                                                    ">
                                                        Logout
                                                    </a>
                                                </div>

         
                                       
            
                 

                <!--footer-->
                    <div class="footer">
                     <p>&copy; My website , all rights reserved</p>
                    </div>
            
        </body>
        
</html>


<script>
    const urlParams = new URLSearchParams(window.location.search);
    const success = urlParams.get('success');

    if (success === '1') {
        Swal.fire({
            title: 'Success!',
            text: 'Dish has been successfully inserted.',
            icon: 'success',
            confirmButtonText: 'OK'
        }).then(() => {
            // Remove ?success=1 from URL after popup closes
            window.history.replaceState({}, document.title, "/insertMenu");
        });
    }
</script>



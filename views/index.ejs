<!DOCTYPE html>
<html>
<head>
    <title>Upload Invoice</title>
    <head>
       <%- include('partials/header1.ejs') %>
       <!--sweet alert notification-->
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

                        
                            <header class="top-header">
                                <div class="header-left">
                                    <img src="/public/images/logo3.png" alt="Logo" class="header-logo">
                                </div>

                                <div class="header-center">
                                    <h1 class="header-title">KitchoraX</h1>
                                    <p class="kitchorax-subtitle">A modern, intelligent, next‑generation kitchen management system.</p>
                                </div>



                                <div class="header-right">
                                    <!-- Add logout button or other items here -->
                                </div>
                            </header>





  
                        <div class="bodyImg2" >

                        </div>                           
                       <style>
                        /*Sign up form */
                        /* Container for image and form */
                             .image-container {
                                 position: relative; /* Needed for absolute positioning inside */
                                 display:flex;
                             }

                                          /* The background image */
                             .image-container img {
                             display: block;   
                            }

                      </style>
                      <style>
                       

                        /* The form overlay */
                             .form-overlay1 {
                                
                                background-size: cover;
                                background-position: center;
                                background-repeat: no-repeat;
                                width: 100%;                              
                                height: 100vh;
                                display:grid;           
                                border-radius: 5px;
                                border: 2px solid rgb(196, 144, 40);
                                background-image: url('/public/images/bgimage.png');
                                border-radius: 8px;
                                box-shadow: 6 8px 10x rgba(0,0,0,0.2);
                            }

                         /* Form styling */
                            .form-overlay1 input{
                              background-color: rgb(249, 249, 249); 
                              height: 50px;    
                              padding: 5px;
                              width: 240px;
                              border:5px;
                              border-radius: 10px;
                              outline: none;
                              margin-bottom: 12px;
                             

                        }
                             .form-overlay1 button {
                               width: 100%;
                               height:auto;
                                padding: 12px;
                                margin-top: 10px;
                                background: #0078ff;
                                color: white;
                                border: none;
                                border-radius: 6px;
                                font-size: 16px;
                                cursor: pointer;
                                transition: 0.2s;
                                                    }
                                                 
                </style>


            <style>
    .upload-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 70vh;
        width: 100%;
        margin-top: 40px;
    }

    .upload-box {
        background: rgba(255, 255, 255, 0.92);
        padding: 35px;
        width: 420px;
        border-radius: 12px;
        border: 2px solid rgb(196, 144, 40);
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        text-align: center;
        backdrop-filter: blur(4px);
    }

    .upload-title {
        font-size: 24px;
        font-weight: bold;
        color: #1f2937;
        margin-bottom: 20px;
    }

    .upload-input {
        width: 100%;
        padding: 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #f9fafb;
        margin-bottom: 18px;
        cursor: pointer;
    }

    .upload-btn {
        width: 100%;
        padding: 12px;
        background: #0078ff;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: 0.2s;
    }

    .upload-btn:hover {
        background: #005fcc;
    }
</style>

               
</head>
</head>
<body>
 <div class="form-overlay1">
    <!-- Centered Upload Box -->
<div class="upload-wrapper">
    <div class="upload-box">

        <h2 class="upload-title">Upload Your Daily Invoice</h2>

        <form action="/upload-invoice" method="POST" enctype="multipart/form-data">
            <input type="file" name="invoice" accept="application/pdf" class="upload-input" required>
            <button type="submit" class="upload-btn">Upload Invoice</button>
        </form>

    </div>
</div>
</div>

                    <div class="footer">
                     <p>&copy; My website , all rights reserved</p>
                    </div>
             
</body>
</html>

